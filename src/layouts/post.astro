---
const { frontmatter } = Astro.props;
---
<div class="articleInfo">
<h1>{ frontmatter.title }</h1>
  <p class="meta">written on { new Date(frontmatter.date).toDateString() }</p>
  <!-- TODO table of contents -->
  <div id="toc"></div>
</div>
<main>
<article class="post">
<slot />
</article>
</main>
